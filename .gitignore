# Added by Cargo
# Contains compiled binaries, artifacts, and documentation
/target/

# Remove this if you are building an application and want to lock dependencies
# Keep this if you are building a library
Cargo.lock

# Backup files generated by rustfmt when formatting code
**/*.rs.bk

# MSVC Windows debugging information (large symbols files)
*.pdb

# Rust compiler crash logs (Internal Compiler Errors)
rustc-ice-*.txt
